#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  --version)
    printf '11.7.0\n'
    ;;
  bin)
    printf '%s/.local/share/pnpm\n' "$HOME"
    ;;
  root)
    printf '%s/.local/share/pnpm/global/node_modules\n' "$HOME"
    ;;
  list)
    if [[ -r "$HOME/.local/share/pnpm/global/node_modules/@deepseek-ai/dsh/package.json" ]]; then
      printf '[{"dependencies":{"@deepseek-ai/dsh":{"version":"1.2.3"}}}]\n'
    else
      printf '[]\n'
    fi
    ;;
  add)
    if [[ ${MOCK_PNPM_INSTALL_SUCCESS:-0} == 1 ]]; then
      package_dir="$HOME/.local/share/pnpm/global/node_modules/@deepseek-ai/dsh"
      mkdir -p "$package_dir"
      printf '{"name":"@deepseek-ai/dsh","version":"1.2.3"}\n' >"$package_dir/package.json"
      printf '#!/usr/bin/env bash\nprintf "1.2.3\\n"\n' >"$HOME/.local/share/pnpm/dsh"
      chmod +x "$HOME/.local/share/pnpm/dsh"
      printf 'mock pnpm install succeeded\n'
      exit 0
    fi
    exit 2
    ;;
  *)
    printf 'Unexpected mock pnpm arguments: %s\n' "$*" >&2
    exit 2
    ;;
esac
